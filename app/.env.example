# Pinata, used by /api/upload to pin box images and metadata to IPFS.
# Create a key at https://app.pinata.cloud/developers/api-keys (pinFileToIPFS + pinJSONToIPFS).
PINATA_JWT=your-pinata-jwt-here
# Your dedicated gateway host, without a scheme, e.g. example-name.mypinata.cloud
PINATA_GATEWAY=your-gateway.mypinata.cloud
